{% extends "layout.twig" %}

{% block title %}Raspicam archive{% endblock %}

{% block head %}
    {{ parent() }}
    <link href="Magnific-Popup-master/dist/magnific-popup.css" rel="stylesheet">
{% endblock %}

{% block content %}

    <h1>Raspicam 1 archive  [{{totalItems}} pic(s)]</h1>
    <p><a class="btn btn-default"  href="cam.php"><span class="glyphicon glyphicon-chevron-left" aria-hidden="true"></span> zurück</a></p>

    {{message|raw}}

    <p>{{paginator|raw}}</p>
    <div class="thumb-container popup-gallery">
    </div>

    {% for file in subFiles %}
	{%if file != "." and file != ".." %}

	    <div class="thumb-wrap">
		<a href="archive/{{file}}">
		    <img class="thumbs" title="" src="archive/{{file}}"/>
		</a>
		<div class="btn-group">
		    <button class="btn btn-danger btn-sm delete" data-href="cam-archive.php?page={{currentPage}}&delete={{file}}">
			<span class="glyphicon glyphicon-trash" aria-hidden="true"></span>
		    </button>
		</div>
	    </div>

	{%endif%}
    {%endfor%}

    <p>{{paginator|raw}}</p>

    <p><a class="btn btn-default" href="cam.php"><span class="glyphicon glyphicon-chevron-left" aria-hidden="true"></span> zurück</a></p>
    <div class="alert alert-info" role="alert">
	<h4>Disc usage:</h4>
	{{diskUsage|raw}}
    </div>



{% endblock %}

{% block footerIncludes %}
    {{ parent() }}
    <script src="Magnific-Popup-master/dist/jquery.magnific-popup.min.js"></script>
    <script src="script.js"></script>
{% endblock %}