{% extends "layout.twig" %}

{% block title %}Raspicam archive{% endblock %}

{% block head %}
    {{ parent() }}
    <meta http-equiv="refresh" content="300">
    <link href="static/Magnific-Popup-master/dist/magnific-popup.css" rel="stylesheet">
{% endblock %}

{% block content %}

    {{message|raw}}

    <p>{{paginator|raw}}</p>
    <div class="thumb-container popup-gallery">

    {% for file in subFiles %}

	    <div class="thumb-wrap">
		<a href="{{file.file}}">
		    <img class="thumbs" title="" src="{{file.thumbPath}}"/>
		</a>
		<div class="btn-group">
		    <button class="btn btn-danger btn-sm delete" data-href="cam-archive.php?page={{currentPage}}&delete={{file.name}}">
			<span class="glyphicon glyphicon-trash" aria-hidden="true"></span>
		    </button>
		</div>
	    </div>

    {%endfor%}
    </div>

    <p>{{paginator|raw}}</p>

{% endblock %}

{% block footerIncludes %}
    {{ parent() }}
    <script src="static/Magnific-Popup-master/dist/jquery.magnific-popup.min.js"></script>
    <script src="static/script.js"></script>
{% endblock %}
