<html>
    <head>
	<title>Raspicam1 current</title>
	<meta http-equiv="refresh" content="15">
	<link href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-BVYiiSIFeK1dGmJRAkycuHAHRg32OmUcww7on3RYdg4Va+PmSTsz/K68vbdEjh4u" crossorigin="anonymous">
	<link href="style.css" rel="stylesheet">
    </head>
    <body>
	<h1>Raspicam 1 current</h1>
	<p>
	<div class="btn-group">
	    <a class="btn btn-default" href="cam-archive.php"><span class="glyphicon glyphicon-list-alt" aria-hidden="true"></span> zum Archiv</a>

	    {% if recording %}

		<div class="btn btn-default">
		    <span class="glyphicon glyphicon-camera green" aria-hidden="true"></span> active
		</div>
		<div class="btn btn-default">
		    <a href="?enable=0">
			<span class="glyphicon glyphicon-stop red" aria-hidden="true"></span> disable
		    </a>
		</div>

	    {% else %}

		<div class="btn btn-default">
		    <span class="glyphicon glyphicon-camera red" aria-hidden="true"></span> inactive
		</div>
		<div class="btn btn-default">
		    <a href="?enable=1">
			<span class="glyphicon glyphicon-play green" aria-hidden="true"></span> enable
		    </a>
		</div>

	    {% endif %}

	    <div class="btn btn-default">
		<a href="cam.php"><span class="glyphicon glyphicon-repeat" aria-hidden="true"></span>&nbsp;refresh</a>
	    </div>
	</div>
    </p>
    <img src="cam.jpg?{{time}}"
	 style="width: 100%;height:auto;max-width:800px"/>
